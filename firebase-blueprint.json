        "car1_glazeType": { "type": "string" },
        "car1_startTime": { "type": "string" },
        "car1_endTime": { "type": "string" },
        "car1_packageCount": { "type": "number" },
        "car1_brickCount": { "type": "number" },
        "car1_totalTileCount": { "type": "number" },
        "car2_number": { "type": "string" },
        "car2_glazeType": { "type": "string" },
        "car2_startTime": { "type": "string" },
        "car2_endTime": { "type": "string" },
        "car2_packageCount": { "type": "number" },
        "car2_brickCount": { "type": "number" },
        "car3_number": { "type": "string" },
        "car3_glazeType": { "type": "string" },
        "car3_startTime": { "type": "string" },
        "car3_endTime": { "type": "string" },
        "car3_packageCount": { "type": "number" },
        "car3_brickCount": { "type": "number" },
        "car4_number": { "type": "string" },
        "car4_glazeType": { "type": "string" },
        "car4_startTime": { "type": "string" },
        "car4_endTime": { "type": "string" },
        "car4_packageCount": { "type": "number" },
        "car4_brickCount": { "type": "number" },
        "car4_totalTileCount": { "type": "number" },
        "machineWaste": { "type": "number" },
        "dryerWaste": { "type": "number" },
        "validationStatus": { "type": "string" },
        "totalPackagedBricks": { "type": "number" },
        "totalBricksInChamber": { "type": "number" },
        "pressSettingEfficiency": { "type": "string" },
        "dryerEfficiency": { "type": "string" },
        "chamberFinalEfficiency": { "type": "string" },
        "pressDryerStatus": { "type": "string" },
        "dryerPerformanceStatus": { "type": "string" },
        "overallKilnInletPerformance": { "type": "string" },
        "chamberUnloadTimeEfficiency": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["date", "month", "shift", "operatorName", "chamberNumber", "product"]
    }
  },
  "firestore": {
    "/kiln_records/{recordId}": {
      "entity": "KilnRecord",
      "description": "Collection of kiln temperature and car operation logs"
    },
    "/dryer_records/{recordId}": {
      "entity": "DryerRecord",
      "description": "Collection of dryer-1400 chamber loading, finger production and unloading logs"
    },
    "/setting_records/{recordId}": {
      "entity": "SettingRecord",
      "description": "Collection of Set_1400 setting, car loading, and packaging logs"
    }
  }
}
