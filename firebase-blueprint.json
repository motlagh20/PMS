{
  "entities": {
    "KilnRecord": {
      "title": "Kiln Production Log Record",
      "description": "Kiln operation, temperature zones, and car input log stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rowNumber": { "type": "number" },
        "date": { "type": "string" },
        "operatorCode": { "type": "string" },
        "operator": { "type": "string" },
        "time": { "type": "string" },
        "raw": { "type": "string" },
        "inputCar": { "type": "string" },
        "productCode": { "type": "string" },
        "productType": { "type": "string" },
        "exhaustTemp": { "type": "number" },
        "preHeat1": { "type": "number" },
        "preHeat2": { "type": "number" },
        "thermostat": { "type": "number" },
        "zone0": { "type": "number" },
        "zone1": { "type": "number" },
        "zone2": { "type": "number" },
        "zone3": { "type": "number" },
        "zone4": { "type": "number" },
        "zone5": { "type": "number" },
        "zone6": { "type": "number" },
        "zone7": { "type": "number" },
        "rapid1": { "type": "number" },
        "rapid2": { "type": "number" },
        "bottomA": { "type": "number" },
        "bottom1": { "type": "number" },
        "bottomB": { "type": "number" },
        "bottom2": { "type": "number" },
        "car44Temp": { "type": "number" },
        "bottomPipeTemp": { "type": "number" },
        "dryerPipeTemp": { "type": "number" },
        "pushingTime": { "type": "string" },
        "outputCar": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["date", "time", "operator"]
    },
    "DryerRecord": {
      "title": "Dryer-1400 Chamber Monitoring Record",
      "description": "Dryer chamber loading, unloading, finger production, and operation logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rowNumber": { "type": "number" },
        "month": { "type": "string" },
        "loadDateSolar": { "type": "string" },
        "loadDateTimeGregorian": { "type": "string" },
        "chamberNumber": { "type": "string" },
        "fingerCount": { "type": "number" },
        "loadingOperator": { "type": "string" },
        "productionType": { "type": "string" },
        "unloadDateTimeSolar": { "type": "string" },
        "unloadDateTimeGregorian": { "type": "string" },
        "unloadingOperator": { "type": "string" },
        "duration": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "createdBy": { "type": "string" }
      },
      "required": ["loadDateSolar", "chamberNumber", "loadingOperator", "productionType"]
    },
    "SettingRecord": {
      "title": "Set_1400 Setting & Wagon Loading Record",
      "description": "Press & Setting car loading, packaging, and efficiency records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rowNumber": { "type": "number" },
        "date": { "type": "string" },
        "month": { "type": "string" },
        "day": { "type": "string" },
        "shift": { "type": "string" },
        "shiftSupervisor": { "type": "string" },
        "operatorName": { "type": "string" },
